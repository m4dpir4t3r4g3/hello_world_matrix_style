#!/usr/bin/env bash
# Opens matrix_hello.py in a fullscreen terminal. Meant to run from your
# desktop's autostart (or i3/sway/Hyprland `exec`) once you're logged in.
#
#   matrix-hello-launch            run once per login (later calls are no-ops)
#   matrix-hello-launch --force    run regardless; extra args go to the script
#
# Env: MATRIX_HELLO_DELAY    seconds to wait for the desktop (default 2)
#      MATRIX_HELLO_TERMINAL force a terminal (konsole, alacritty, ...)
#      MATRIX_HELLO_NAME     who to wake up (default Neo)
set -u

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$DIR/term.sh"

# One run per login: several autostart mechanisms may fire, and
# $XDG_RUNTIME_DIR is wiped on logout/reboot, so the lock resets itself.
if [[ "${1:-}" == "--force" ]]; then
    shift
else
    mkdir "${XDG_RUNTIME_DIR:-/tmp}/matrix-hello.lock" 2>/dev/null || exit 0
fi

sleep "${MATRIX_HELLO_DELAY:-2}"

matrix_open_terminal 1 matrix-hello python3 "$DIR/matrix_hello.py" "$@" || exit 1
wait
